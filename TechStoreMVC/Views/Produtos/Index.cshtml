@* Passo 03 - Criar as Views *@
@* Se Estou na View(Index) de Produtos, qual sera a model
que devo usar????????*@
@model List<TechStoreMVC.Models.Produto>

    @{
        ViewData["Title"] = "Produtos";
   }

<h1>
    Lista de Produtos
</h1>
<table class="table table-striped">
    @* Tipo de tabela acima com Bootstrap*@
    <thead>
    @* Cabeçalho da tabela*@    
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Preço</th>
            <th>Estoque</th>
        </tr>
    </thead>
     @* Imagine que a cada novo produto você tivesse que repetir isso
        toda a vez, seriam linhas sem fim. Por isso, usamos o foreach.
        
        O Foreach repete enquanto houver produtos existentes e, se
        existir, eles serão exibidos para ti nessa tela. *@
    <tbody>
        @foreach(var produto in Model)
        {
        <tr>
            <th scope>@produto.Id</th>
            <td>@produto.Id</td>
            <td>@produto.Nome</td>
            <td>R$ @produto.Preco.ToString("F2")</td>
            <td>@produto.Estoque</td> 
            <td>
                <a asp-action="Details" asp-route-id="@produto.Id" class="btn btn-primary">
                    Detalhes
                </a>
                   <a asp-action="Edit" asp-route-id="@produto.Id" class="btn btn-primary">
                    Editar
                </a>
            </td>
        </tr>
        }
    </tbody>
</table>