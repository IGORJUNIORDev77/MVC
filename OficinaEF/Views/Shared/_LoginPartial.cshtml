@if (User.Identity?.IsAuthenticated == true)
{
    <span class="small text-muted">@User.Identity.Name</span>
    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post" class="d-inline">
        <button class="btn btn-outline-secondary btn-sm">Sair</button>
    </form>
}
else
{
    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary btn-sm">Entrar</a>
    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-primary btn-sm">Criar conta</a>
}