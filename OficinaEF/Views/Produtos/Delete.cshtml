@model Produto
@{ ViewData["Title"] = "Confirmar exclusão"; }
<h1>Excluir @Model.Nome?</h1><p>Produtos com histórico de pedidos serão desativados para preservar os registros.</p>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post"><button class="btn btn-danger">Confirmar exclusão</button><a asp-action="Index" class="btn btn-outline-secondary">Voltar</a></form>