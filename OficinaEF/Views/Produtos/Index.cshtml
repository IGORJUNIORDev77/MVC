@model IEnumerable<Produto>
@{ ViewData["Title"] = "Produtos"; }
<section class="abertura mb-4">
    <h1>Seu próximo produto está aqui.</h1>
    <p>Confira as opções, escolha a quantidade e faça seu pedido.</p>
</section>
<form method="get" asp-action="Index" class="row g-2 mb-4">
    <div class="col-md-6"><label for="busca" class="form-label">Buscar produto</label><input id="busca" name="busca" value="@ViewBag.Busca" class="form-control" /></div>
    <div class="col-md-4"><label for="categoriaId" class="form-label">Categoria</label>
        <select id="categoriaId" name="categoriaId" class="form-select"><option value="">Todas as categorias</option>
            @foreach (Categoria categoria in ViewBag.Categorias)
            {
                <option value="@categoria.Id" selected="@(categoria.Id == (int?)ViewBag.CategoriaId)">@categoria.Nome</option>
            }
        </select>
    </div>
    <div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">Buscar</button></div>
</form>
@if (!Model.Any()) { <div class="alert alert-info">Nenhum produto encontrado.</div> }
<div class="row g-4">
@foreach (var produto in Model)
{
    <div class="col-sm-6 col-lg-4 col-xl-3">
        <article class="card produto-card h-100">
            <partial name="_FotoProduto" model="produto" />
            <div class="card-body d-flex flex-column">
                <p class="text-muted small">@produto.Categoria?.Nome</p><h2 class="h5">@produto.Nome</h2>
                <p class="preco mt-auto pt-3">@produto.Preco.ToString("C")</p>
                <p class="small">@(produto.Estoque > 0 ? $"{produto.Estoque} unidades disponíveis" : "Esgotado")</p>
                <a asp-action="Detalhes" asp-route-id="@produto.Id" class="btn btn-outline-primary mb-2">Ver detalhes</a>
                @if (produto.Estoque > 0)
                { <a asp-controller="Pedidos" asp-action="Create" asp-route-produtoId="@produto.Id" class="btn btn-primary">Fazer pedido</a> }
            </div>
        </article>
    </div>
}
</div>