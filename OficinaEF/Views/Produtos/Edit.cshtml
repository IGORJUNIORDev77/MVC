@model Produto
@{ ViewData["Title"] = "Editar cadastro"; }
<h1>Editar cadastro</h1><form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="formulario"><input type="hidden" asp-for="Id" /><input type="hidden" name="Versao" value="@Convert.ToBase64String(Model.Versao)" /><partial name="_Formulario" model="Model" /></form>