@model IEnumerable<Pedido>
@{ ViewData["Title"] = "Meus pedidos"; }
<h1>Meus pedidos</h1>
@if (!Model.Any()) { <p>Você ainda não realizou pedidos.</p> }
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Pedido</th><th>Produto</th><th>Quantidade</th><th>Total</th><th>Status</th><th>Ações</th></tr></thead><tbody>
@foreach (var item in Model)
{ <tr><td>#@item.Id</td><td>@item.NomeProduto</td><td>@item.Quantidade</td><td>@item.ValorTotal.ToString("C")</td><td>@item.Status</td><td><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Ver detalhes</a></td></tr> }
</tbody></table></div><a asp-controller="Home" asp-action="Index" class="btn btn-primary">Ver produtos</a>