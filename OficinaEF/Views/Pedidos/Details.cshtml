@model Pedido
@{ ViewData["Title"] = "Pedido #" + Model.Id; }
<h1>Pedido #@Model.Id</h1><dl class="row">
<dt class="col-sm-3">Cliente</dt><dd class="col-sm-9">@Model.Usuario?.Email</dd>
<dt class="col-sm-3">Produto</dt><dd class="col-sm-9">@Model.NomeProduto</dd>
<dt class="col-sm-3">Quantidade</dt><dd class="col-sm-9">@Model.Quantidade</dd>
<dt class="col-sm-3">Preço aplicado</dt><dd class="col-sm-9">@Model.PrecoUnitario.ToString("C")</dd>
<dt class="col-sm-3">Total</dt><dd class="col-sm-9">@Model.ValorTotal.ToString("C")</dd>
<dt class="col-sm-3">Data (UTC)</dt><dd class="col-sm-9">@Model.CriadoEmUtc.ToString("dd/MM/yyyy HH:mm")</dd>
<dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd></dl>
@if (Model.Status == StatusPedido.Recebido)
{
    <form asp-action="Cancelar" asp-route-id="@Model.Id" method="post" class="d-inline"><button class="btn btn-outline-danger">Cancelar pedido</button></form>
    @if (User.IsInRole("Admin"))
    { <form asp-action="Concluir" asp-route-id="@Model.Id" method="post" class="d-inline"><button class="btn btn-success">Concluir pedido</button></form> }
}
<a asp-action="Index" class="btn btn-outline-secondary">Meus pedidos</a>
@if (User.IsInRole("Admin")) { <a asp-action="Gestao" class="btn btn-outline-primary">Todos os pedidos</a> }